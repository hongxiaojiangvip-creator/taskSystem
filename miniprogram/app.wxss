/* 全局样式 */
page {
  background: #f5f6f8;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
  color: #333;
}

.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.btn-primary {
  background: #4caf50;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
}

.btn-primary[disabled] {
  background: #a5d6a7;
  color: #fff;
}

.text-muted {
  color: #999;
  font-size: 26rpx;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  justify-content: space-between;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #eee;
}
