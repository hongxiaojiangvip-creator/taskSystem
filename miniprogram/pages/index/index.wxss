.login-card {
  text-align: center;
  padding: 60rpx 28rpx;
}
.login-title {
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}
.login-btn {
  margin-top: 40rpx;
}

.streak-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #4caf50, #66bb6a);
  color: #fff;
}
.streak-main {
  flex: 1;
  text-align: center;
}
.streak-num {
  font-size: 88rpx;
  font-weight: bold;
  line-height: 1;
}
.streak-label {
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.9;
}
.streak-side {
  flex: 1;
  display: flex;
  justify-content: space-around;
}
.side-item { text-align: center; }
.side-num { font-size: 40rpx; font-weight: bold; }
.streak-side .text-muted { color: rgba(255,255,255,0.85); }

.done-tip {
  text-align: center;
  font-size: 30rpx;
  color: #4caf50;
  padding: 16rpx 0;
}
.re-checkin {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #999;
}

.cal-head { margin-bottom: 16rpx; }
.cal-title { font-size: 30rpx; font-weight: bold; }
.cal-arrow { padding: 0 24rpx; font-size: 36rpx; color: #4caf50; }
.cal-week { margin-bottom: 8rpx; }
.cal-grid { display: flex; flex-wrap: wrap; }
.cal-cell {
  width: 14.28%;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}
.cal-cell.checked {
  color: #fff;
}
.cal-cell.checked text {
  background: #4caf50;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
}
.cal-cell.today text {
  border: 2rpx solid #4caf50;
  border-radius: 50%;
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
}

.link-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
}
