<view class="container">

  <!-- 未登录 -->
  <view wx:if="{{!userInfo}}" class="card login-card">
    <view class="login-title">🏃 健身打卡</view>
    <view class="text-muted">坚持每一天,记录更好的自己</view>
    <button class="btn-primary login-btn" bindtap="onLogin">微信登录</button>
  </view>

  <!-- 已登录 -->
  <block wx:else>
    <!-- 连续天数卡片 -->
    <view class="card streak-card">
      <view class="streak-main">
        <view class="streak-num">{{overview.currentStreak || 0}}</view>
        <view class="streak-label">连续打卡(天)</view>
      </view>
      <view class="streak-side">
        <view class="side-item">
          <view class="side-num">{{overview.totalDays || 0}}</view>
          <view class="text-muted">累计天数</view>
        </view>
        <view class="side-item">
          <view class="side-num">{{overview.maxStreak || 0}}</view>
          <view class="text-muted">最长连续</view>
        </view>
      </view>
    </view>

    <!-- 今日打卡按钮 -->
    <view class="card">
      <button wx:if="{{!checkedToday}}" class="btn-primary" bindtap="goCheckin">今日打卡 ✅</button>
      <view wx:else class="done-tip">今天已打卡,继续保持!🎉
        <view class="re-checkin" bindtap="goCheckin">再记一笔 ></view>
      </view>
    </view>

    <!-- 日历 -->
    <view class="card">
      <view class="cal-head row between">
        <text class="cal-arrow" bindtap="prevMonth"><</text>
        <text class="cal-title">{{year}} 年 {{month}} 月</text>
        <text class="cal-arrow" bindtap="nextMonth">></text>
      </view>
      <view class="cal-week row">
        <view wx:for="{{weekTitles}}" wx:key="*this" class="cal-cell text-muted">{{item}}</view>
      </view>
      <view class="cal-grid">
        <view wx:for="{{days}}" wx:key="index"
              class="cal-cell {{item.checked ? 'checked' : ''}} {{item.isToday ? 'today' : ''}}">
          <text wx:if="{{!item.empty}}">{{item.day}}</text>
        </view>
      </view>
    </view>

    <view class="card link-row" bindtap="goRecords">
      <text>查看全部打卡记录</text>
      <text class="text-muted">></text>
    </view>
  </block>
</view>
