<view class="container">
  <view wx:if="{{list.length === 0 && !loading}}" class="empty text-muted">还没有动态,快去打卡吧~</view>

  <view wx:for="{{list}}" wx:key="id" class="card feed">
    <view class="row between" data-id="{{item.id}}" bindtap="goDetail">
      <view class="row">
        <image class="avatar" src="{{item.avatar}}" />
        <view class="meta">
          <view class="nick">{{item.nickname}}</view>
          <view class="text-muted">{{item.checkinDate}} · {{item.sportName}}</view>
        </view>
      </view>
      <view class="badge">{{item.duration}}分钟</view>
    </view>

    <view wx:if="{{item.remark}}" class="remark" data-id="{{item.id}}" bindtap="goDetail">{{item.remark}}</view>

    <view wx:if="{{item.images.length}}" class="thumbs">
      <image wx:for="{{item.images}}" wx:for-item="img" wx:key="*this" class="thumb" src="{{img}}" mode="aspectFill" />
    </view>

    <view class="row between foot">
      <text class="text-muted">约 {{item.calorie}} 千卡</text>
      <view class="like {{item.liked ? 'liked' : ''}}" data-id="{{item.id}}" data-index="{{index}}" catchtap="toggleLike">
        {{item.liked ? '❤️' : '🤍'}} {{item.likeCount}}
      </view>
    </view>
  </view>

  <view wx:if="{{noMore && list.length}}" class="text-muted end">— 没有更多了 —</view>
</view>
