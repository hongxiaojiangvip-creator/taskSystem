.form-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.form-item:last-child { border-bottom: none; }
.form-label { font-size: 30rpx; }
.form-input {
  text-align: right;
  font-size: 32rpx;
  width: 200rpx;
  color: #4caf50;
  font-weight: bold;
}
.tip { padding: 0 16rpx 30rpx; font-size: 26rpx; }
