.login-card { text-align: center; padding: 60rpx 28rpx; }
.login-btn { margin-top: 30rpx; }

.profile { display: flex; align-items: center; }
.avatar-btn {
  padding: 0;
  background: transparent;
  line-height: normal;
  width: 120rpx;
  height: 120rpx;
}
.avatar-btn::after { border: none; }
.big-avatar { width: 120rpx; height: 120rpx; border-radius: 50%; background: #eee; }
.profile-info { margin-left: 24rpx; }
.nick { font-size: 36rpx; font-weight: bold; margin-bottom: 8rpx; }

.stat-row { display: flex; }
.stat { flex: 1; text-align: center; }
.stat-num { font-size: 44rpx; font-weight: bold; color: #4caf50; }

.menu-item {
  display: flex;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 30rpx;
}
.menu-item:last-child { border-bottom: none; }

.logout-btn {
  margin-top: 30rpx;
  background: #fff;
  color: #e53935;
  border-radius: 48rpx;
  font-size: 30rpx;
}
