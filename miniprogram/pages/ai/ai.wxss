.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #999;
  border-radius: 12rpx;
}
.tab.active { background: #4caf50; color: #fff; }

.ai-card { min-height: 200rpx; }
.ai-loading { color: #999; font-size: 28rpx; text-align: center; padding: 60rpx 0; }
.ai-content {
  font-size: 30rpx;
  line-height: 1.8;
  color: #333;
  white-space: pre-wrap;
}
.refresh { margin-top: 28rpx; }

.label { font-size: 30rpx; font-weight: bold; margin-bottom: 16rpx; }
.textarea {
  background: #f5f6f8;
  border-radius: 12rpx;
  padding: 20rpx;
  width: 100%;
  box-sizing: border-box;
  height: 140rpx;
  font-size: 30rpx;
  margin-bottom: 24rpx;
}

/* 聊天 */
.chat-wrap {
  display: flex;
  flex-direction: column;
  height: calc(100vh - 140rpx);
}
.chat-list { flex: 1; }
.chat-tip { text-align: center; padding: 80rpx 40rpx; }
.msg { display: flex; margin-bottom: 24rpx; }
.msg.user { justify-content: flex-end; }
.msg .bubble {
  max-width: 78%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}
.msg.user .bubble { background: #4caf50; color: #fff; }
.msg.assistant .bubble { background: #fff; color: #333; }

.chat-input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  gap: 16rpx;
}
.chat-input {
  flex: 1;
  background: #fff;
  border-radius: 40rpx;
  padding: 20rpx 28rpx;
  font-size: 30rpx;
}
.send-btn {
  background: #4caf50;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 0 36rpx;
  line-height: 72rpx;
}
