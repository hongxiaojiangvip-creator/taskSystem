.ai-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #4caf50, #66bb6a);
  color: #fff;
}
.ai-banner-title { font-size: 32rpx; font-weight: bold; margin-bottom: 6rpx; }
.ai-banner .text-muted { color: rgba(255,255,255,0.85); }
.ai-banner-arrow { font-size: 36rpx; }

.grid { display: flex; flex-wrap: wrap; }
.grid-item { width: 25%; text-align: center; }
.num { font-size: 44rpx; font-weight: bold; color: #4caf50; }

.sec-title { font-size: 30rpx; font-weight: bold; }
.goal-item { margin-top: 24rpx; font-size: 28rpx; }
.bar {
  margin-top: 12rpx;
  height: 16rpx;
  background: #eee;
  border-radius: 8rpx;
  overflow: hidden;
}
.bar-fill { height: 100%; background: #4caf50; border-radius: 8rpx; }

.range { font-size: 26rpx; }
.range-btn {
  padding: 6rpx 20rpx;
  color: #999;
  border-radius: 24rpx;
}
.range-btn.active { background: #e8f5e9; color: #4caf50; }
.chart { width: 100%; height: 360rpx; margin-top: 20rpx; }
