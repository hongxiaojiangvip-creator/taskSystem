.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #999;
  border-radius: 12rpx;
}
.tab.active { background: #4caf50; color: #fff; }

.empty { text-align: center; padding: 120rpx 0; }

.rank-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.rank-row:last-child { border-bottom: none; }
.rank-no {
  width: 56rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #bbb;
}
.rank-1 { color: #f5a623; }
.rank-2 { color: #9b9b9b; }
.rank-3 { color: #cd7f32; }
.rank-info { flex: 1; margin-left: 20rpx; }
.rank-nick { font-size: 30rpx; }
.rank-days { font-size: 30rpx; font-weight: bold; color: #4caf50; }
